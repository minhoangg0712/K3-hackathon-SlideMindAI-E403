# Copy sang .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# Key để VLearn Tutor gọi Gemini API. Lấy free tại https://aistudio.google.com/apikey
# Không có key thì Tutor tự chuyển sang provider `mock` và mọi câu trả lời
# bị gắn nhãn MOCK trên giao diện.
GEMINI_API_KEY=

# Buộc dùng mock kể cả khi đã có key (để phát triển/demo offline).
# Giá trị: gemini | mock. Bỏ trống = tự chọn theo GEMINI_API_KEY.
TUTOR_PROVIDER=

# Cascade model: bậc trước hết quota hoặc lỗi thì tụt xuống bậc sau.
# Free tier của Google siết theo ngày và các model cũ bị gỡ dần — kiểm tra
# model nào còn khả dụng với key của bạn bằng:
#   node --env-file=.env.local scripts/check-gemini.mjs
# (tính đến 30/07/2026, gemini-2.5-* đã ngừng nhận người dùng mới)
GEMINI_MODEL_CASCADE=gemini-3.5-flash,gemini-3.5-flash-lite

# Đổi nếu muốn frontend trỏ sang backend VLearn thật thay vì mock nội bộ.
# NEXT_PUBLIC_API_PREFIX=/api/backend
